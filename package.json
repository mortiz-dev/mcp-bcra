{
  "name": "mcp-bcra",
  "version": "2.0.0",
  "description": "Read-only Model Context Protocol server for public BCRA APIs",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "mcp-bcra": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.11",
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "bun run clean && tsc",
    "lint": "biome check src test scripts",
    "format": "biome check --write src test scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run build && MCP_RUN_STDIO_E2E=1 vitest run test/mcp.protocol.test.ts test/stdio.e2e.test.ts",
    "audit": "bun audit",
    "pack:check": "bun scripts/check-package.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e && bun run pack:check",
    "release:check": "bun run audit && bun run check && bun run test:coverage && bun run smoke:package",
    "prepack": "bun run build",
    "start": "node dist/index.js",
    "start:bun": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "smoke:live": "bun scripts/live-smoke.ts",
    "smoke:package": "bun scripts/smoke-package.ts"
  },
  "keywords": [
    "mcp",
    "bcra",
    "argentina",
    "finance"
  ],
  "author": "Miguel Ortiz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mortiz-dev/mcp-bcra.git"
  },
  "bugs": {
    "url": "https://github.com/mortiz-dev/mcp-bcra/issues"
  },
  "homepage": "https://github.com/mortiz-dev/mcp-bcra#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.14",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25"
  }
}
