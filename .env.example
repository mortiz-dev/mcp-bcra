# Upstream BCRA client. Values outside the accepted range are ignored.
BCRA_HTTP_TIMEOUT_MS=15000
BCRA_HTTP_MAX_RESPONSE_BYTES=2097152
BCRA_HTTP_MAX_CONCURRENCY=4
BCRA_HTTP_RATE_LIMIT_PER_SECOND=5

# stdio is the default and ignores every MCP_* variable below.
# MCP_TRANSPORT=stdio

# Opt-in Streamable HTTP resource server. See docs/http-server.md.
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8080
# MCP_RESOURCE_URL=https://mcp.example.com/mcp
# MCP_AUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# MCP_AUTH_AUDIENCE=api://<api-application-client-id>
# MCP_AUTH_REQUIRED_SCOPES=mcp.access
# MCP_AUTH_REQUIRED_ROLES=
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# Leave unset in production. HTTP only, for a private local process.
# MCP_AUTH_INSECURE_DEV=false
